# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
# Optional: override the local LLM model (default anthropic/claude-haiku-5.5)
OPENROUTER_MODEL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sandbox sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# Our Twilio number (SMS / voice)
TWILIO_PHONE_NUMBER=
TAVILY_API_KEY=
PORT=8787
# Optional: point shared/db.ts at a different data folder (e.g. for tests)
DATA_DIR=
# Local admin pages and admin functions (x-admin-token header)
ADMIN_TOKEN=
# Optional: Offlinebase private inference (not used yet)
OFFLINEBASE_API_KEY=
OFFLINEBASE_BASE_URL=
