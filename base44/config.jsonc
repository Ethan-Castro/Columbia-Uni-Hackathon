// Base44 project config. functions/ and shared/ here are GENERATED from the
// repo-root handlers/ and shared/ by scripts/base44-sync.ts. Edit the root copies.
{
  "name": "NYC Navigator",
  "description": "Living map of services for immigrant New Yorkers",
  // Public (no login) so Claude and ChatGPT can call /functions/mcp anonymously.
  "visibility": "public",
  // The web app (web/) is built with the Base44 functions path and served as the site.
  "site": {
    "installCommand": "npm --prefix web install",
    "buildCommand": "VITE_FUNCTIONS_BASE=/api/apps/6aca64c59c3d35bc8bab2330/functions/ npm --prefix web run build",
    "outputDirectory": "./web/dist"
  }
}
